<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 6 · Listing details -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Image area (category icon until photos are supported) -->
            <FrameLayout
                android:id="@+id/imageArea"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/cc_pine_tint">
                <ImageView
                    android:id="@+id/imgCategory"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_back"
                    app:tint="@color/cc_ink"
                    android:contentDescription="Back" />
                <ImageButton
                    android:id="@+id/btnSaveTop"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/cc_ink"
                    android:contentDescription="Save listing" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_sheet_top"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/txtCourseTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_pine"
                        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtConditionTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tag_outline"
                        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/cc_ink" android:textSize="12sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tag_outline"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/cc_ink" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtTitle"
                    style="@style/CC.Heading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/txtPrice"
                    style="@style/CC.Heading.Price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="28sp" />

                <TextView style="@style/CC.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/description" />
                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.25"
                    android:textColor="#3D4540"
                    android:textSize="14sp" />

                <!-- Seller -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/txtSellerAvatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_amber"
                        android:gravity="center"
                        android:textColor="@color/cc_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">
                        <TextView android:id="@+id/txtSeller" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/cc_ink" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/txtSellerDept" style="@style/CC.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/cc_pine"
                        android:contentDescription="@string/verified_student" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPosted"
                    style="@style/CC.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_line"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_square_outline"
            android:src="@drawable/ic_heart"
            app:tint="@color/cc_ink"
            android:contentDescription="Save listing" />

        <Button
            android:id="@+id/btnMessageSeller"
            style="@style/CC.Button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/message_seller"
            app:icon="@drawable/ic_chat" />

        <TextView
            android:id="@+id/txtOwnerNote"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_message_info"
            android:gravity="center"
            android:textColor="@color/cc_pine"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
