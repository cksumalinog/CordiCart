<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4 · Marketplace dashboard (the app's main screen) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/feedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="48dp">

            <!-- Greeting row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_pine"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:contentDescription="Open profile"
                    android:text="UC" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtGreeting"
                        style="@style/CC.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text="Good day," />
                    <TextView
                        android:id="@+id/txtName"
                        style="@style/CC.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:text="Student" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnNotify"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_white_border"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/cc_ink"
                    android:contentDescription="Notifications" />
            </LinearLayout>

            <!-- Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/cc_muted"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/cc_ink"
                    android:textSize="14sp"
                    android:importantForAutofill="no" />

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/cc_line" />

                <ImageButton
                    android:id="@+id/btnFilter"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/cc_pine"
                    android:contentDescription="Filters" />
            </LinearLayout>

            <!-- SDG 12 banner -->
            <LinearLayout
                android:id="@+id/sdgBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:textColor="@color/cc_amber"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="@string/sdg_label" />
                    <TextView
                        style="@style/CC.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:text="@string/sdg_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSellNow"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_amber"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/cc_ink"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/sell_now" />
            </LinearLayout>

            <!-- Category chips (scroll sideways) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                <TextView android:id="@+id/chipAll" style="@style/CC.Chip" android:paddingStart="16dp" android:paddingEnd="16dp" android:text="All" />
                <TextView android:id="@+id/chipTextbooks" style="@style/CC.Chip" android:drawableStart="@drawable/ic_book_sm" android:text="Textbooks" />
                <TextView android:id="@+id/chipUniforms" style="@style/CC.Chip" android:drawableStart="@drawable/ic_shirt_sm" android:text="Uniforms &amp; PE" />
                <TextView android:id="@+id/chipDrafting" style="@style/CC.Chip" android:drawableStart="@drawable/ic_ruler_sm" android:text="Drafting &amp; Art" />
                <TextView android:id="@+id/chipLab" style="@style/CC.Chip" android:drawableStart="@drawable/ic_flask_sm" android:text="Lab &amp; Clinical" />
                <TextView android:id="@+id/chipGadgets" style="@style/CC.Chip" android:drawableStart="@drawable/ic_calculator_sm" android:text="Calculators &amp; Gadgets" />
                <TextView android:id="@+id/chipOthers" style="@style/CC.Chip" android:drawableStart="@drawable/ic_grid_sm" android:text="Others" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:gravity="bottom"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/txtSectionTitle"
                    style="@style/CC.Heading.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/fresh_on_campus" />
                <TextView
                    style="@style/CC.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:text="@string/newest_first" />
            </LinearLayout>

            <!-- 2-column grid of listings -->
            <com.cordicart.cordicart.ExpandedGridView
                android:id="@+id/itemGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:horizontalSpacing="12dp"
                android:verticalSpacing="12dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="2"
                android:stretchMode="columnWidth" />

            <!-- Shown when no listing matches -->
            <LinearLayout
                android:id="@+id/emptyView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_tint">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_search"
                        app:tint="@color/cc_pine"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView
                    style="@style/CC.Heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="17sp"
                    android:text="@string/empty_title" />
                <TextView
                    style="@style/CC.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/empty_body" />
                <TextView
                    android:id="@+id/btnEmptySell"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_amber"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/cc_ink"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/sell_an_item" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_top_line"
        android:elevation="4dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/navMarket"
            style="@style/CC.NavItem"
            android:contentDescription="Market">
            <ImageView style="@style/CC.NavIcon" android:src="@drawable/ic_home" app:tint="@color/cc_pine" />
            <TextView style="@style/CC.NavLabel" android:text="Market" android:textColor="@color/cc_pine" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navSaved"
            style="@style/CC.NavItem"
            android:contentDescription="Saved">
            <ImageView style="@style/CC.NavIcon" android:src="@drawable/ic_heart" app:tint="@color/cc_muted" />
            <TextView style="@style/CC.NavLabel" android:text="Saved" android:textColor="@color/cc_muted" />
        </LinearLayout>
        <TextView
            style="@style/CC.NavLabel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:gravity="center_horizontal|bottom"
            android:paddingBottom="12dp"
            android:text="@string/nav_sell" />
        <LinearLayout
            android:id="@+id/navMessages"
            style="@style/CC.NavItem"
            android:contentDescription="Messages">
            <ImageView style="@style/CC.NavIcon" android:src="@drawable/ic_chat" app:tint="@color/cc_muted" />
            <TextView style="@style/CC.NavLabel" android:text="Messages" android:textColor="@color/cc_muted" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navProfile"
            style="@style/CC.NavItem"
            android:contentDescription="Profile">
            <ImageView style="@style/CC.NavIcon" android:src="@drawable/ic_user" app:tint="@color/cc_muted" />
            <TextView style="@style/CC.NavLabel" android:text="Profile" android:textColor="@color/cc_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating "+" button: declared after the nav bar and raised higher, so it sits on top -->
    <ImageButton
        android:id="@+id/fabPostItem"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_fab"
        android:elevation="8dp"
        android:src="@drawable/ic_plus"
        app:tint="@color/cc_ink"
        android:contentDescription="Post an item" />
</RelativeLayout>
