<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_alignParentTop="true">

        <TextView
            android:id="@+id/btnProfileHeader"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="👤"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/badge_pill"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CordiCart"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#000000"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnNotify"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="🔔"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnMessages"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✉️"
            android:textSize="16sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#000000"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♡"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved"
                android:textSize="11sp"
                android:textColor="#666666"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textSize="11sp"
                android:textColor="#666666"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="16sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="#666666"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/headerBar"
        android:layout_above="@id/bottomNav"
        android:paddingHorizontal="12dp">

        <!-- Search Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="🔍 Search by subject or item..."
                android:textSize="13sp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/edittext_border"
                android:inputType="text"/>

            <TextView
                android:id="@+id/btnFilterIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/badge_border"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Category Pills ScrollView -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/badge_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/chipTextbooks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Textbooks"
                    android:textColor="#333333"
                    android:background="@drawable/badge_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/chipUniforms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uniforms"
                    android:textColor="#333333"
                    android:background="@drawable/badge_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/chipDrafting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drafting &amp; Lab Gear"
                    android:textColor="#333333"
                    android:background="@drawable/badge_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Shown automatically when no listing matches -->
        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="No listings found. Try another category or search, or post the first item!"
            android:textColor="#888888"
            android:visibility="gone"/>

        <!-- 2-Column Market Grid -->
        <GridView
            android:id="@+id/itemGridView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="2"
            android:verticalSpacing="8dp"
            android:horizontalSpacing="8dp"
            android:stretchMode="columnWidth"/>
    </LinearLayout>

    <!-- Floating Action Button (+ Post Item) -->
    <Button
        android:id="@+id/fabPostItem"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="┼  Post Item"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2D2D2D"
        android:paddingHorizontal="20dp"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="6dp"/>

</RelativeLayout>
