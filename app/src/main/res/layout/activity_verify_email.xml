<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3 · Verify your email -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="-12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/cc_ink"
                android:contentDescription="Back" />

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                style="@style/CC.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@string/step_2_of_2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_progress_on" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_progress_on" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_circle_tint">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mail"
                app:tint="@color/cc_pine"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView style="@style/CC.Heading.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="@string/verify_title" />
        <TextView style="@style/CC.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/verify_sent_to" />
        <TextView
            android:id="@+id/txtEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/cc_ink" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="-4dp"
            android:orientation="horizontal">
            <EditText android:id="@+id/otp1" style="@style/CC.OtpBox" android:contentDescription="Digit 1" />
            <EditText android:id="@+id/otp2" style="@style/CC.OtpBox" android:contentDescription="Digit 2" />
            <EditText android:id="@+id/otp3" style="@style/CC.OtpBox" android:contentDescription="Digit 3" />
            <EditText android:id="@+id/otp4" style="@style/CC.OtpBox" android:contentDescription="Digit 4" />
            <EditText android:id="@+id/otp5" style="@style/CC.OtpBox" android:contentDescription="Digit 5" />
            <EditText android:id="@+id/otp6" style="@style/CC.OtpBox" android:contentDescription="Digit 6" />
        </LinearLayout>

        <include
            android:id="@+id/msgBox"
            layout="@layout/layout_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/CC.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="@string/code_expires" />
            <TextView
                android:id="@+id/txtResend"
                style="@style/CC.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resend_code" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <Button
            android:id="@+id/btnVerify"
            style="@style/CC.Button.Amber"
            android:layout_width="match_parent"
            android:text="@string/verify_student_id"
            app:icon="@drawable/ic_shield_check"
            />

        <TextView
            android:id="@+id/txtChangeEmail"
            style="@style/CC.Caption"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textSize="13sp"
            android:text="@string/wrong_email" />
    </LinearLayout>
</ScrollView>
