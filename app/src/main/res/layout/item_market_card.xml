<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/badge_border"
    android:layout_margin="4dp">

    <!-- Image Placeholder Box -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E8E8E8"
        android:layout_marginBottom="8dp">

        <!-- Wireframe diagonal cross lines indicator text -->
        <TextView
            android:id="@+id/txtImageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Item Image"
            android:textSize="12sp"
            android:textColor="#555555"
            android:textStyle="bold"
            android:background="@drawable/badge_border"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </FrameLayout>

    <!-- Badges Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/txtCourseTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MATH 101"
            android:textSize="11sp"
            android:textColor="#333333"
            android:background="@drawable/badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/txtConditionTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gently Used"
            android:textSize="11sp"
            android:textColor="#666666"
            android:background="@drawable/badge_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"/>
    </LinearLayout>

    <!-- Item Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculus 1 Textbook"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#000000"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="2dp"/>

    <!-- Price or Barter Tag -->
    <TextView
        android:id="@+id/txtPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₱250"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#000000"/>

</LinearLayout>
