<?xml version="1.0" encoding="utf-8"?>
<!-- Groups the two Manrope files so normal text uses Regular and bold text uses Bold.
     Both android: and app: attributes are needed for older Android versions. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/manrope_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/manrope_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
