rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a UC student email.
    function isStudent() {
      return request.auth != null
        && request.auth.token.email.matches('.*@students[.]uc-bcf[.]edu[.]ph$');
    }

    function isOwner(uid) {
      return isStudent() && request.auth.uid == uid;
    }

    // Student who has completed OTP verification.
    function isVerified() {
      return isStudent()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true;
    }

    match /users/{uid} {
      allow read: if isStudent();
      allow create: if isOwner(uid) && request.resource.data.verified == false;
      allow update: if isOwner(uid);
    }

    match /otps/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /listings/{listingId} {
      allow read: if isVerified();
      // You can only post as yourself, and new posts start as available.
      allow create: if isVerified()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'available';
      // Only the seller can edit or delete their own listing.
      allow update, delete: if isVerified() && resource.data.sellerId == request.auth.uid;
    }

    // Chat rules will be added with Feature 3.
  }
}
